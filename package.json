{
  "name": "ashveil",
  "version": "0.1.0",
  "description": "An isometric action-RPG core loop: pull a pack, spend skills, loot, get stronger, go deeper.",
  "license": "MIT",
  "scripts": {
    "dev": "npm run assets && vite",
    "build": "npm run assets && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx headless/run.ts",
    "spike:dev": "vite --config spike/deck/vite.config.ts",
    "spike:build": "vite build --config spike/deck/vite.config.ts",
    "assets": "node scripts/fetch-assets.mjs",
    "art:fit": "node scripts/art/fit.mjs",
    "art:profile": "node scripts/art/profile.mjs",
    "motion:dev": "npm run assets && vite --config spike/motion/vite.config.ts",
    "site:dev": "node website/scripts/generate.mjs && vite --config website/vite.config.mjs --host 0.0.0.0",
    "site:build": "node website/scripts/generate.mjs && vite build --config website/vite.config.mjs",
    "site:test": "node --test website/tests/*.site.mjs",
    "site:preview": "vite preview --config website/vite.config.mjs --host 0.0.0.0",
    "perf": "node scripts/perf.mjs",
    "gate": "npm run typecheck && npm run test && npm run build",
    "gate:balance": "npm run gate && npm run sim -- sweep --seeds 6 --minutes 4",
    "gate:perf": "npm run gate && npm run perf"
  },
  "type": "module",
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "marked": "^16.4.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "private": true
}
