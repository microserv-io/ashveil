{
  "title": "ashveil.body-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "family", "contractVersion", "body", "source", "canonicalHeight", "helpers",
               "bones", "landmarks", "footprint", "restSignatureSha256", "inverseBindSha256", "budget",
               "gates", "reportFile"],
  "properties": {
    "schema": { "const": "ashveil.body-manifest.v1" },
    "family": { "type": "string", "pattern": "^[a-z]+\\.v[0-9]+$" },
    "contractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "body": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "canonicalHeight": { "type": "number", "minimum": 0.1 },
    "helpers": { "type": "boolean" },
    "bones": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" } },
    "landmarks": {
      "type": "object",
      "additionalProperties": { "type": "array", "minItems": 3, "items": { "type": "number" } }
    },
    "footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heel", "toe", "lift", "pitch"],
      "properties": {
        "heel": { "type": "number" },
        "toe": { "type": "number" },
        "lift": { "type": "number", "minimum": 0 },
        "pitch": { "type": "number" }
      }
    },
    "restSignatureSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "inverseBindSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "budget": {
      "type": "object",
      "required": ["triangles", "materials", "meshes", "bones", "maxInfluencesPerVertex"],
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "gates": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "reportFile": { "type": "string" }
  }
}
