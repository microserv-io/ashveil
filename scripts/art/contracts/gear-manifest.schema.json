{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ashveil.gear-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "family",
    "contractVersion",
    "body",
    "slot",
    "piece",
    "source",
    "bones",
    "inverseBindSha256",
    "covers",
    "under",
    "hides",
    "weights",
    "alignment",
    "budget",
    "gates",
    "reportFile"
  ],
  "properties": {
    "schema": {
      "const": "ashveil.gear-manifest.v1"
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.v[0-9]+$"
    },
    "contractVersion": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "slot": {
      "enum": [
        "feet",
        "legs",
        "waist",
        "chest",
        "back",
        "hands",
        "shoulders",
        "head"
      ]
    },
    "piece": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "bones": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "inverseBindSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "covers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "feet",
          "legs",
          "waist",
          "chest",
          "back",
          "hands",
          "shoulders",
          "head"
        ]
      }
    },
    "under": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "hides": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "weights": {
      "enum": [
        "transfer",
        "stiff",
        "rigid"
      ]
    },
    "alignment": {
      "oneOf": [
        {
          "$ref": "#/$defs/alignment"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "L",
            "R"
          ],
          "properties": {
            "L": {
              "$ref": "#/$defs/alignment"
            },
            "R": {
              "$ref": "#/$defs/alignment"
            }
          }
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triangles",
        "materials",
        "meshes",
        "maxInfluencesPerVertex"
      ],
      "properties": {
        "triangles": {
          "type": "integer",
          "minimum": 0
        },
        "materials": {
          "type": "integer",
          "minimum": 0
        },
        "meshes": {
          "type": "integer",
          "minimum": 1
        },
        "maxInfluencesPerVertex": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "reportFile": {
      "type": "string"
    }
  },
  "$defs": {
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scale",
        "yawDegrees",
        "translation"
      ],
      "properties": {
        "scale": {
          "type": "number"
        },
        "yawDegrees": {
          "enum": [
            0,
            180
          ]
        },
        "translation": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "spanOverride": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "axis",
            "from",
            "to",
            "metres",
            "factor"
          ],
          "properties": {
            "axis": {
              "enum": [
                "X",
                "Y",
                "Z"
              ]
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "metres": {
              "type": "number",
              "minimum": 0
            },
            "factor": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "limb": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bone",
            "band",
            "fade",
            "correctionDegrees",
            "seatMetres",
            "pieceAxis",
            "boneDirection",
            "bandVertices"
          ],
          "properties": {
            "bone": {
              "type": "string"
            },
            "band": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "fade": {
              "type": "number",
              "minimum": 0
            },
            "correctionDegrees": {
              "type": "number",
              "minimum": 0
            },
            "seatMetres": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "pieceAxis": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "boneDirection": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "bandVertices": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "roll": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bone",
            "scoredRegionVertices",
            "stepDegrees",
            "chosenDegrees",
            "candidates",
            "best",
            "secondBest",
            "atZero"
          ],
          "properties": {
            "bone": {
              "type": "string"
            },
            "scoredRegionVertices": {
              "type": "integer",
              "minimum": 1
            },
            "stepDegrees": {
              "type": "number"
            },
            "chosenDegrees": {
              "type": "number"
            },
            "candidates": {
              "type": "integer",
              "minimum": 1
            },
            "best": {
              "$ref": "#/$defs/rollCandidate"
            },
            "secondBest": {
              "$ref": "#/$defs/rollCandidate"
            },
            "atZero": {
              "$ref": "#/$defs/rollCandidate"
            }
          }
        },
        "enclose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bone",
            "fraction",
            "step",
            "maxGrow",
            "scoredRegionVertices",
            "chosenScale",
            "insideFractionAtOne",
            "insideFractionChosen",
            "reachedTarget",
            "steps"
          ],
          "properties": {
            "bone": {
              "type": "string"
            },
            "fraction": {
              "type": "number"
            },
            "step": {
              "type": "number"
            },
            "maxGrow": {
              "type": "number"
            },
            "scoredRegionVertices": {
              "type": "integer",
              "minimum": 1
            },
            "chosenScale": {
              "type": "number",
              "minimum": 1
            },
            "insideFractionAtOne": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "insideFractionChosen": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reachedTarget": {
              "type": "boolean"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/encloseStep"
              }
            }
          }
        }
      }
    },
    "rollCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "degrees",
        "meanDistanceMetres",
        "outsideFraction",
        "score"
      ],
      "properties": {
        "degrees": {
          "type": "number"
        },
        "meanDistanceMetres": {
          "type": "number",
          "minimum": 0
        },
        "outsideFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "score": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "encloseStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scale",
        "insideFraction"
      ],
      "properties": {
        "scale": {
          "type": "number",
          "minimum": 1
        },
        "insideFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
