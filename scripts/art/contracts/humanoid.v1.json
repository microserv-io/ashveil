  "schema": "ashveil.family-contract.v1",
  "family": "humanoid.v1",
  "version": "1.2.0",
  "canonicalHeight": 1.8,
  "frame": {
    "up": "+Y",
    "forward": "+Z",
    "anatomicalLeft": "+X",
    "note": "The runtime frame of src/render/procedural/joints.ts. Blender is +Z up and -Y front; scripts/art/fit/frame.py is the only converter."
  },
  "boneAxisRule": {
    "primary": "local +Y from head to tail, so a bone points at its child",
    "limbSecondary": "local +X along the body's lateral axis, so knee and elbow hinge about one local axis",
    "spineSecondary": "local +Z faces runtime forward",
    "restOrientationInRuntimeFile": "identity",
    "why": "An identity bone rest orientation makes semanticskeleton.ts derive an identity rest-axis correction for every semantic joint. A non-identity correction on a body this pipeline built is a fitter bug, not a profile detail."
  },
  "budget": {
    "maxTriangles": 30000,
    "maxMaterials": 4,
    "maxMeshes": 8,
    "maxInfluencesPerVertex": 4
  },
