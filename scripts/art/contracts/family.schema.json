{
  "title": "ashveil.family-contract.v1",
  "type": "object",
  "required": ["schema", "family", "version", "canonicalHeight", "frame", "boneAxisRule", "budget",
               "landmarks", "minimumLandmarkConfidence", "symmetryToleranceHeight", "bones", "helpers",
               "sockets", "regions", "gates"],
  "properties": {
    "schema": { "const": "ashveil.family-contract.v1" },
    "family": { "type": "string", "pattern": "^[a-z]+\\.v[0-9]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "canonicalHeight": { "type": "number", "minimum": 0.1 },
    "frame": {
      "type": "object",
      "required": ["up", "forward", "anatomicalLeft"],
      "properties": {
        "up": { "const": "+Y" },
        "forward": { "const": "+Z" },
        "anatomicalLeft": { "const": "+X" },
        "note": { "type": "string" }
      }
    },
    "boneAxisRule": {
      "type": "object",
      "required": ["primary", "limbSecondary", "spineSecondary", "restOrientationInRuntimeFile"],
      "properties": {
        "primary": { "type": "string" },
        "limbSecondary": { "type": "string" },
        "spineSecondary": { "type": "string" },
        "restOrientationInRuntimeFile": { "const": "identity" },
        "why": { "type": "string" }
      }
    },
    "budget": {
      "type": "object",
      "required": ["maxTriangles", "maxMaterials", "maxMeshes", "maxInfluencesPerVertex"],
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "landmarks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "minimumLandmarkConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "symmetryToleranceHeight": { "type": "number", "minimum": 0 },
    "bones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "parent", "deform", "head", "tail", "chain", "role"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
          "parent": { "type": ["string", "null"] },
          "deform": { "type": "boolean" },
          "head": { "type": "string" },
          "tail": { "type": "string" },
          "chain": { "enum": ["spine", "limb"] },
          "role": { "type": "string" }
        }
      }
    },
    "helpers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "parent", "deform", "chain", "head", "tail"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
          "parent": { "type": "string" },
          "deform": { "type": "boolean" },
          "chain": { "enum": ["spine", "limb"] },
          "head": { "type": "object", "additionalProperties": false,
                     "required": ["from", "towards", "along"],
                     "properties": { "from": { "type": "string" }, "towards": { "type": "string" },
                                     "along": { "type": "number", "minimum": 0, "maximum": 1 } } },
          "tail": { "type": "object", "additionalProperties": false,
                     "required": ["from", "towards", "along"],
                     "properties": { "from": { "type": "string" }, "towards": { "type": "string" },
                                     "along": { "type": "number", "minimum": 0, "maximum": 1 } } }
        }
      }
    },
    "helperNote": { "type": "string" },
    "sockets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "bone"],
        "additionalProperties": false,
        "properties": { "role": { "type": "string" }, "bone": { "type": "string" } }
      }
    },
    "regions": {
      "type": "object",
      "required": ["required", "excluded", "allowedBones"],
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" } },
        "allowedBones": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "gates": {
      "type": "object",
      "required": ["uprightDegrees", "torsoRakeDegrees", "heightTolerance", "groundToleranceMetres",
                   "farFieldDisplacement90Cm", "farFieldDisplacement150Cm", "flexion60DisplacementCm",
                   "normalInversions90", "normalInversions150", "clavicleShare", "ankleAlongFootMax",
                   "maxLimbReachHeight", "maxSpineReachHeight"],
      "additionalProperties": { "type": ["number", "string"] }
    }
  }
}
